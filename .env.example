# Copia este fichero a .env y rellena tu clave. No subas el .env real.
# Valores oficiales segun https://dev.meta.ai/docs/quickstart :
#   base URL = https://api.meta.ai/v1
#   modelo   = muse-spark-1.3
# La documentacion oficial nombra la clave como MODEL_API_KEY;
# aqui usamos META_API_KEY por convenio del proyecto (mismo valor).
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Backend FastAPI (valores por defecto si se omiten):
# EXPERTIUM_DB=backend/data/expertium.db
# CORS_ORIGINS=http://localhost:5173
# SEED_DOCS=true
